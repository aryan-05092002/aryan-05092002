import pandas as pd
import numpy as np
from sklearn.linear_model import LassoCV
from sklearn.preprocessing import StandardScaler

# Variables
variables = ['REAL_GDP_QPC_YOY', 'var1', 'var2', 'var3']  # Replace with your variable list
indicators = variables[1:]  # all except GDP for predictors

initial_train_end = pd.Period('2020Q4', freq='Q')
evaluation_end = pd.Period('2025Q2', freq='Q')
current_train_end = initial_train_end

forecasted = []
actuals = []
quarters = []

while current_train_end < evaluation_end:
    train_data = qpc_data1.loc[:current_train_end, variables].dropna()
    if len(train_data) < 10:  # Require enough data points
        current_train_end += 1
        continue

    # Define predictors and response
    X_train = train_data[indicators]
    y_train = train_data['REAL_GDP_QPC_YOY']

    # Standardize predictors
    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(X_train)

    # Fit LassoCV model (internally performs CV to select alpha)
    lasso = LassoCV(cv=5, random_state=42).fit(X_train_scaled, y_train)

    # Prepare test predictors for next period
    next_period = current_train_end + 1
    if next_period not in qpc_data1.index:
        break

    try:
        X_test_raw = qpc_data1.loc[next_period, indicators]
    except KeyError:
        break

    if X_test_raw.isnull().any():
        current_train_end += 1
        continue

    X_test_scaled = scaler.transform(X_test_raw.values.reshape(1, -1))
    forecast = lasso.predict(X_test_scaled)[0]

    actual = qpc_data1.loc[next_period, 'REAL_GDP_QPC_YOY']

    forecasted.append(forecast)
    actuals.append(actual)
    quarters.append(next_period)

    current_train_end += 1

# Output results
results_df = pd.DataFrame({'Quarter': quarters,
                           'Forecast_ML_Lasso': forecasted,
                           'Actual': actuals}).set_index('Quarter')
print(results_df)


