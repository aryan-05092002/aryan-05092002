import pandas as pd
import numpy as np
from sklearn.linear_model import LassoCV
from sklearn.preprocessing import StandardScaler

variables = [col for col in qpc_data1.columns if col not in ['GDP_QPC', 'decomposition']]
gdp_col = 'REAL_GDP_QPC_YOY'  # Your GDP variable name
indicators = variables.copy()

initial_train_end = pd.Period('2020Q4', freq='Q')
evaluation_end = pd.Period('2025Q2', freq='Q')
current_train_end = initial_train_end

forecasted = []
actuals = []
quarters = []
lower_bounds = []
upper_bounds = []

n_bootstrap = 100  # Number of bootstrap samples
confidence_level = 90  # Percent

while current_train_end < evaluation_end:
    train_data = qpc_data1.loc[qpc_data1.index <= current_train_end, [gdp_col] + indicators].dropna()
    if len(train_data) < 10:
        current_train_end += 1
        continue

    # Prepare data
    X = train_data[indicators]
    y = train_data[gdp_col]

    df_xy = pd.concat([y, X], axis=1).dropna()
    y_train = df_xy[gdp_col]
    X_train = df_xy[indicators]

    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(X_train)

    # Fit Lasso on full training data
    lasso = LassoCV(cv=5, random_state=42).fit(X_train_scaled, y_train)

    # Prepare test data for next period
    next_period = current_train_end + 1
    if next_period not in qpc_data1.index:
        break

    X_test_raw = qpc_data1.loc[next_period, indicators]
    if X_test_raw.isnull().any():
        current_train_end += 1
        continue

    X_test_scaled = scaler.transform(X_test_raw.values.reshape(1, -1))
    forecast = lasso.predict(X_test_scaled)[0]

    # Bootstrap to get confidence intervals
    forecasts_boot = []
    n_samples = X_train_scaled.shape[0]
    for _ in range(n_bootstrap):
        idx = np.random.choice(n_samples, size=n_samples, replace=True)
        X_resampled = X_train_scaled[idx]
        y_resampled = y_train.iloc[idx]

        lasso_boot = LassoCV(cv=5, random_state=42).fit(X_resampled, y_resampled)
        forecast_boot = lasso_boot.predict(X_test_scaled)[0]
        forecasts_boot.append(forecast_boot)

    lower_bound = np.percentile(forecasts_boot, (100 - confidence_level) / 2)
    upper_bound = np.percentile(forecasts_boot, 100 - (100 - confidence_level) / 2)

    actual = qpc_data1.loc[next_period, gdp_col]

    forecasted.append(forecast)
    actuals.append(actual)
    quarters.append(next_period)
    lower_bounds.append(lower_bound)
    upper_bounds.append(upper_bound)

    current_train_end += 1

results_df = pd.DataFrame({
    'Quarter': quarters,
    'Forecast_ML_Lasso': forecasted,
    'Actual': actuals,
    'CI_Lower': lower_bounds,
    'CI_Upper': upper_bounds
}).set_index('Quarter')

print(results_df)




import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from statsmodels.tsa.seasonal import STL

# ==========================================
# 1. LOAD DATA & PARSE DATES (Crucial Step)
# ==========================================

# Replace 'your_data.csv' with your actual file name
# We assume your columns are named roughly like this: 'Date' and 'MoM_Rate'
try:
    df = pd.read_csv('your_data.csv')
except FileNotFoundError:
    # CREATING MOCK DATA FOR DEMONSTRATION (If no file exists)
    dates = pd.date_range(start='01-2018', periods=60, freq='MS')
    df = pd.DataFrame({
        'Date': dates.strftime('%m-%Y'), # Simulating your "mm-yyyy" format
        'MoM_Rate': np.random.normal(0.5, 0.2, 60) + [0.5 if i%12==0 else 0 for i in range(60)]
    })
    print("⚠️ No CSV found. Using generated mock data for demonstration.\n")

# --- DATE PARSING LOGIC ---
# This converts "01-2023" (mm-yyyy) into a real Datetime object
df['Date'] = pd.to_datetime(df['Date'], format='%m-%Y')

# Set Date as index and force it to 'Month Start' frequency
# This stops STL from complaining about missing period information
df.set_index('Date', inplace=True)
df = df.asfreq('MS') 

# Handle any missing data that might appear after setting frequency
# (Linear interpolation is standard for small gaps in economic data)
df['MoM_Rate'] = df['MoM_Rate'].interpolate(method='linear')

# ==========================================
# 2. RECONSTRUCT THE INDEX (Base 100)
# ==========================================
# We need a continuous index to adjust, not just rates.

# Convert MoM % to a multiplier (e.g., 0.5% -> 1.005)
df['Multiplier'] = 1 + (df['MoM_Rate'] / 100)

# Chain the multipliers to build the index starting at 100
df['Synthetic_Index'] = 100 * df['Multiplier'].cumprod()

# ==========================================
# 3. RUN STL (Log-Additive Method)
# ==========================================
# We take Log because Inflation is Multiplicative (Percentage-based).
# STL is Additive. Log transforms Multiplicative -> Additive.

# A. Log Transform
log_index = np.log(df['Synthetic_Index'])

# B. Run STL Decomposition
# period=12 is implicit because we set freq='MS', but we define it to be safe.
# seasonal=13 is the robust standard.
stl = STL(log_index, period=12, seasonal=13, robust=True).fit()

# C. Remove Seasonality
# We subtract the seasonal component from the Log Index
df['Log_SA_Index'] = log_index - stl.seasonal

# D. Reverse Log (Exponentiate) to get real values
df['SA_Index'] = np.exp(df['Log_SA_Index'])

# ==========================================
# 4. CALCULATE FINAL SA RATES
# ==========================================

# SA Month-over-Month (%)
df['SA_MoM'] = df['SA_Index'].pct_change() * 100

# SA Year-over-Year (%)
df['SA_YoY'] = df['SA_Index'].pct_change(periods=12) * 100

# ==========================================
# 5. EXPORT & VISUALIZE
# ==========================================

# Save to CSV
output_filename = "seasonally_adjusted_inflation.csv"
df[['MoM_Rate', 'SA_MoM', 'SA_YoY']].to_csv(output_filename)
print(f"✅ Success! Data saved to {output_filename}")

# Display last 5 months
print("\n--- Recent Adjusted Data ---")
print(df[['MoM_Rate', 'SA_MoM', 'SA_YoY']].tail())

# Plotting
plt.figure(figsize=(12, 6))
plt.plot(df.index, df['MoM_Rate'], label='Original MoM', color='lightgray', linestyle='--')
plt.plot(df.index, df['SA_MoM'], label='Seasonally Adjusted MoM', color='blue', linewidth=2)
plt.title('Inflation: Original vs Seasonally Adjusted (STL Method)')
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()





import pandas as pd
import numpy as np
import statsmodels.api as sm
import matplotlib.pyplot as plt

# ==========================================
# 1. SETUP (Load your data)
# ==========================================
# Assuming 'df' has your "MoM_Rate" and a Datetime Index
# For this example, I'll generate the same mock data as before
dates = pd.date_range(start='01-2018', periods=60, freq='MS')
df = pd.DataFrame({'MoM_Rate': np.random.normal(0.5, 0.2, 60) + [0.5 if i%12==0 else 0 for i in range(60)]}, index=dates)

# RECONSTRUCT INDEX (Base 100)
df['Multiplier'] = 1 + (df['MoM_Rate'] / 100)
df['Synthetic_Index'] = 100 * df['Multiplier'].cumprod()

# Log Transform (Crucial for Inflation)
df['Log_Index'] = np.log(df['Synthetic_Index'])

# ==========================================
# 2. RUN UCM (Unobserved Components Model)
# ==========================================
# We define the components we want:
# - level='local linear trend': Allows the trend to bend up and down.
# - seasonal=12: Captures the monthly seasonality.
# - cycle=True: OPTIONAL. Isolates business cycles (booms/busts) separate from the trend.

model = sm.tsa.UnobservedComponents(
    df['Log_Index'],
    level='local linear trend',
    seasonal=12,
    # cycle=True,  # Uncomment this if you want to isolate business cycles too
    irregular=True
)

# Fit the model (The Kalman Filter works its magic here)
result = model.fit()

# ==========================================
# 3. EXTRACT RESULTS
# ==========================================
# UCM stores the "Seasonal" component in the results wrapper

# Get the seasonal component (in Log scale)
log_seasonal_component = result.seasonal.smoothed

# Remove seasonality: Log Index - Log Seasonal
df['Log_SA_Index'] = df['Log_Index'] - log_seasonal_component

# Exponentiate back to real values
df['SA_Index'] = np.exp(df['Log_SA_Index'])

# Calculate Final SA Rates
df['SA_MoM'] = df['SA_Index'].pct_change() * 100

# ==========================================
# 4. VIEW & PLOT
# ==========================================
print(result.summary()) # Shows you statistical significance of seasonality!

plt.figure(figsize=(12, 8))

# Plot 1: The SA Rate
plt.subplot(2, 1, 1)
plt.plot(df.index, df['MoM_Rate'], label='Original MoM', alpha=0.5)
plt.plot(df.index, df['SA_MoM'], label='UCM Adjusted MoM', color='red', linewidth=2)
plt.legend()
plt.title('Inflation Adjusted via UCM (State Space)')

# Plot 2: The Components
plt.subplot(2, 1, 2)
plt.plot(df.index, np.exp(result.trend.smoothed), label='Trend (Core Inflation)', color='green')
plt.title('Underlying Trend (Core Inflation Direction)')
plt.legend()

plt.tight_layout()
plt.show()




import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from statsmodels.tsa.seasonal import STL

# ==========================================
# 1. DEFINE THE CORE FUNCTION
# ==========================================
def get_sa_mom(mom_series, seasonal_window=13):
    """
    Takes a Series of MoM inflation rates, runs Log-STL, 
    and returns the Seasonally Adjusted MoM rates.
    """
    # A. Clean Data (Handle missing values or gaps)
    # We use linear interpolation to prevent STL crashes
    clean_series = mom_series.interpolate(method='linear')
    
    # B. Reconstruct Index (Base 100)
    multiplier = 1 + (clean_series / 100)
    synthetic_index = 100 * multiplier.cumprod()
    
    # C. Log Transform (Multiplicative Adjustment)
    log_index = np.log(synthetic_index)
    
    # D. Run STL
    # period=12 is standard for monthly data
    stl = STL(log_index, period=12, seasonal=seasonal_window, robust=True).fit()
    
    # E. Remove Seasonality & Reverse Log
    log_sa_index = log_index - stl.seasonal
    sa_index = np.exp(log_sa_index)
    
    # F. Calculate SA MoM Rate
    sa_mom = sa_index.pct_change() * 100
    
    return sa_mom

# ==========================================
# 2. LOAD & PREPARE DATA
# ==========================================

# MOCK DATA GENERATION (Replace this block with pd.read_csv)
dates = pd.date_range(start='01-2018', periods=60, freq='MS')
data = {
    'Food': np.random.normal(0.8, 0.3, 60) + [1.0 if i%12==0 else 0 for i in range(60)], # Jan spikes
    'Energy': np.random.normal(0.5, 1.0, 60) + [1.5 if i%12==6 else 0 for i in range(60)], # July spikes
    'Housing': np.random.normal(0.2, 0.1, 60) # Stable
}
df = pd.DataFrame(data, index=dates)

# ==========================================
# 3. THE BULK PROCESSING LOOP
# ==========================================

# Create a container for the new adjusted data
df_sa = pd.DataFrame(index=df.index)

print("Starting Seasonal Adjustment...")

# Loop through every column in your original dataframe
for category in df.columns:
    print(f"Processing: {category}")
    
    # Apply the function to the column
    sa_series = get_sa_mom(df[category])
    
    # Store it in the new dataframe with a suffix
    df_sa[f"{category}_SA"] = sa_series

print("\n✅ Done! All categories adjusted.")

# ==========================================
# 4. EXPORT & COMPARE
# ==========================================

# Merge original and SA data for easy comparison
final_df = pd.concat([df, df_sa], axis=1)

# Save to CSV
final_df.to_csv("All_Categories_Adjusted.csv")

# Quick Check: Compare Food Raw vs Food SA
print(final_df[['Food', 'Food_SA']].tail())

# Visualization
plt.figure(figsize=(10, 5))
plt.plot(final_df.index, final_df['Food'], label='Food (Raw)', alpha=0.5)
plt.plot(final_df.index, final_df['Food_SA'], label='Food (SA)', linewidth=2)
plt.title("Bulk Adjustment Example: Food Category")
plt.legend()
plt.show()
