import pandas as pd
import numpy as np
from scipy.optimize import minimize
import warnings
warnings.filterwarnings('ignore')

def hamilton_filter(y, k=3, trim=0.02):
    """Hamilton filter for monthly REER (k=3, trim=0.02)."""
    T = len(y)
    if T < 2*k + 10:
        return y
    
    X = np.zeros((T-k, k))
    for i in range(k):
        X[:, i] = y[k+i] - y[i:i+(T-k)]
    
    def objective(theta):
        filt = np.dot(X, theta)
        return np.var(filt)
    
    res = minimize(objective, x0=np.ones(k)/k, 
                   method='L-BFGS-B', 
                   bounds=[(-1,1)]*k)
    theta_opt = res.x
    
    filt = np.dot(X, theta_opt)
    trend = np.zeros(T)
    trend[k:] = filt.cumsum()
    
    alpha = trim / (1 + trim)
    
    for t in range(T-2, k-1, -1):
        trend[t] = alpha * trend[t] + (1-alpha) * trend[t+1]
    
    for t in range(k, T):
        trend[t] = alpha * trend[t] + (1-alpha) * trend[t-1]
    
    return trend

def process_bruegel_reer(excel_file, sheet_name='Bruegel', k=3, trim=0.02):
    """Process Bruegel REER data from specified sheet."""
    print("🔄 Loading Bruegel REER data...")
    df = pd.read_excel(excel_file, sheet_name=sheet_name, index_col=0)
    df.index = pd.to_datetime(df.index, format='%Y-%m')
    
    print(f"📊 {len(df)} months | {len(df.columns)} countries")
    print("Countries:", ', '.join(df.columns.tolist()))
    
    results = {}
    for col in df.columns:
        reer_series = df[col].dropna()
        reer_series = reer_series[reer_series > 0]
        
        if len(reer_series) > 24:
            reer_log = np.log(reer_series.values)
            trend_log = hamilton_filter(reer_log, k, trim)
            
            # ✅ SCALING FIX: Match raw levels (~100 range)
            scale_factor = np.mean(reer_log) - np.mean(trend_log)
            trend_log_scaled = trend_log + scale_factor
            results[col] = pd.Series(np.exp(trend_log_scaled), index=reer_series.index)
    
    results_df = pd.DataFrame(results)
    print(f"🎉 Processed {len(results)} countries")
    return df, results_df

