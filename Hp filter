import pandas as pd
import numpy as np
from scipy.optimize import minimize
import warnings
import matplotlib.pyplot as plt
warnings.filterwarnings('ignore')

def hamilton_filter(y, k=3, trim=0.02):
    """
    Hamilton filter optimized for monthly REER series (k=3, trim=0.02).
    Returns productivity trend component.
    """
    T = len(y)
    if T < 2*k + 10:
        return y
    
    # Lagged differences matrix
    X = np.zeros((T-k, k))
    for i in range(k):
        X[:, i] = y[k+i] - y[i:i+(T-k)]
    
    # Minimize variance of filtered residuals
    def objective(theta):
        filt = np.dot(X, theta)
        return np.var(filt)
    
    res = minimize(objective, x0=np.ones(k)/k, method='L-BFGS-B')
    theta_opt = res.x
    
    # Apply filter and cumsum for trend
    filt = np.dot(X, theta_opt)
    trend = np.zeros(T)
    trend[k:] = filt.cumsum()
    
    # Endpoint correction (forward-backward)
    alpha = trim / (1 + trim)
    
    # Backward pass
    for t in range(T-2, k-1, -1):
        trend[t] = alpha * trend[t] + (1-alpha) * trend[t+1]
    
    # Forward pass
    for t in range(k, T):
        trend[t] = alpha * trend[t] + (1-alpha) * trend[t-1]
    
    return trend

def process_bruegel_reer(excel_file, sheet_name=0, k=3, trim=0.02):
    """
    Complete Hamilton filter pipeline for Bruegel monthly REER data.
    Columns = country names. Optimized for EEMEA nowcasting.
    """
    print("🔄 Loading Bruegel REER data...")
    df = pd.read_excel(excel_file, sheet_name=sheet_name, index_col=0)
    df.index = pd.to_datetime(df.index, format='%Y-%m')
    
    print(f"📊 Loaded: {len(df)} months ({df.index[0].strftime('%b %Y')} to {df.index[-1].strftime('%b %Y')})")
    print(f"🌍 Countries found: {len(df.columns)}")
    print("\nCountries:", ', '.join(df.columns.tolist()))
    
    results = {}
    skipped = []
    
    for col in df.columns:
        reer_series = df[col].dropna()
        reer_series = reer_series[reer_series > 0]
        
        if len(reer_series) > 24:
            reer_log = np.log(reer_series.values)
            trend_log = hamilton_filter(reer_log, k=k, trim=trim)
            reer_adj = np.exp(trend_log)
            results[col] = pd.Series(reer_adj, index=reer_series.index)
            print(f"✅ {col}: {len(reer_series)} obs processed")
        else:
            skipped.append(col)
            print(f"⏭️  {col}: skipped ({len(reer_series)} obs)")
    
    if skipped:
        print(f"\n⚠️  Skipped {len(skipped)} countries: {', '.join(skipped)}")
    
    results_df = pd.DataFrame(results)
    print(f"\n🎉 Hamilton filter complete! Productivity-adjusted REER for {len(results)} countries")
    
    return df, results_df

