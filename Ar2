import statsmodels.api as sm
from statsmodels.regression.linear_model import OLS

forecasted = []
actuals = []
quarters = []

current_train_end = initial_train_end  # assume this is defined as pd.Period

while current_train_end <= evaluation_end:
    # Get training data with lags for AR(2)
    train_data = qpc_data1.loc[:current_train_end].copy()

    # Create lags
    train_data['gdp_lag1'] = train_data['REAL_GDP_QPC'].shift(1)
    train_data['gdp_lag2'] = train_data['REAL_GDP_QPC'].shift(2)

    # Drop NA rows (due to lags)
    train_data = train_data.dropna(subset=['REAL_GDP_QPC', 'gdp_lag1', 'gdp_lag2'])

    test_period = current_train_end + 1
    if test_period not in qpc_data1.index:
        break

    test_obs = qpc_data1.loc[test_period]

    # Check for NA in needed columns for test
    if pd.isna(test_obs['REAL_GDP_QPC']) or pd.isna(test_obs['gdp_lag1']) or pd.isna(test_obs['gdp_lag2']):
        current_train_end += 1
        continue

    # Prepare train X and y
    X_train = train_data[['gdp_lag1', 'gdp_lag2']]
    y_train = train_data['REAL_GDP_QPC']

    X_train = sm.add_constant(X_train)
    model = OLS(y_train, X_train).fit()

    # Prepare test X using lagged values from the test_obs or previous known values
    X_test = {
        'gdp_lag1': test_obs['gdp_lag1'],
        'gdp_lag2': test_obs['gdp_lag2'],
    }
    X_test = pd.DataFrame(X_test, index=[0])
    X_test = sm.add_constant(X_test, has_constant='add')

    forecast = model.predict(X_test)[0]

    forecasted.append(forecast)
    actuals.append(test_obs['REAL_GDP_QPC'])
    quarters.append(test_period)

    current_train_end += 1

results_df = pd.DataFrame({
    'Quarter': quarters,
    'Forecast': forecasted,
    'Actual': actuals
}).set_index('Quarter')

print(results_df)
