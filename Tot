import pandas as pd
import numpy as np

# Sample DataFrame structure: columns = ['month', 'commodity', 'Egypt', 'Nigeria', 'USA', ...]
data = {
    'month': ['Jan-10', 'Jan-10', 'Jan-10', 'Feb-10', 'Feb-10'],
    'commodity': ['Oil', 'Electronics', 'Textiles', 'Oil', 'Electronics'],
    'Egypt': [1.2, 0.0, -0.5, 1.5, 0.0],
    'Nigeria': [3.8, 0.0, 0.0, 4.2, 0.0],
    'USA': [2.5, -1.2, 0.8, 3.1, -0.9]
}
df = pd.DataFrame(data)

print("Sample DataFrame:")
print(df)

# Identify country columns (exclude 'month', 'commodity')
country_cols = [col for col in df.columns if col not in ['month', 'commodity']]
print("\nCountry columns:", country_cols)

# Create dictionary: {month: (commodities_list, countries_dict)}
terms_of_trade = {}

for month in df['month'].unique():
    month_data = df[df['month'] == month]
    
    # Commodities for this month (unique, sorted)
    commodities = sorted(month_data['commodity'].dropna().unique())
    
    # Countries dict: {country: trade_balance_series}
    countries = {}
    for country in country_cols:
        countries[country] = month_data.set_index('commodity')[country].reindex(commodities).fillna(0.0)
    
    terms_of_trade[month] = (commodities, countries)

print("\nterms_of_trade['Jan-10']:")
month_key = 'Jan-10'
print("Commodities:", terms_of_trade[month_key][0])
print("Countries dict keys:", list(terms_of_trade[month_key][1].keys()))
print("Egypt values:", terms_of_trade[month_key][1]['Egypt'].values)
print("Type:", type(terms_of_trade[month_key][1]['Egypt']))  # Series



