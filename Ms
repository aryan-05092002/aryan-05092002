# Define your original target variable name (e.g., 'Log_IV')
original_target_name = 'Log_IV' 

# Set your strictness for dropping variables in Step 2 (0.10 = 90% confidence)
p_val_threshold = 0.10  

# ==========================================
# STEP 1: STATIONARITY PURGE (ADF TEST)
# ==========================================
print("--- STEP 1: AUTOMATED STATIONARITY CHECK ---")

def make_stationary(series, signif=0.05):
    """Checks ADF p-value. Returns stationary series (levels or 1st difference)."""
    # Drop NaNs just for the test calculation
    clean_series = series.dropna()
    p_val = adfuller(clean_series, autolag='AIC')[1]
    
    if p_val < signif:
        print(f"[I(0)] {series.name: <20} | Kept in levels (p-val: {p_val:.4f})")
        return series
    else:
        diff_series = series.diff()
        diff_p_val = adfuller(diff_series.dropna(), autolag='AIC')[1]
        new_name = f"Delta_{series.name}"
        diff_series.name = new_name
        print(f"[I(1)] {series.name: <20} | Differenced -> {new_name} (p-val: {diff_p_val:.4f})")
        return diff_series

# Create a new dataframe to hold the purely stationary data
stationary_data = pd.DataFrame(index=df.index)

# Loop through all columns and apply the transformation
for col in df.columns:
    stationary_data[col] = make_stationary(df[col])

# Drop the first row (which became NaN due to any differencing)
stationary_data.dropna(inplace=True)

# Identify the new name of your target variable (in case it got differenced)
stationary_target_name = original_target_name
if f"Delta_{original_target_name}" in stationary_data.columns:
    stationary_target_name = f"Delta_{original_target_name}"

# ==========================================
# STEP 2: BASELINE ARX FILTER & PRUNING
# ==========================================
print("\n--- STEP 2: BASELINE ARX FILTER ---")

# 1. Create the AR(1) lag for the target variable
stationary_data['Target_Lag1'] = stationary_data[stationary_target_name].shift(1)

# Drop the new NaN created by shifting
stationary_data.dropna(inplace=True)

# 2. Define Endogenous (Y) and Exogenous (X) variables
Y = stationary_data[stationary_target_name]

# X includes the AR(1) term AND all other exogenous variables
X_raw = stationary_data.drop(columns=[stationary_target_name])
X_raw = sm.add_constant(X_raw)

# 3. Run the Baseline OLS Model (using HAC robust standard errors)
baseline_model = sm.OLS(Y, X_raw).fit(cov_type='HAC', cov_kwds={'maxlags': 1})

# ==========================================
# STEP 2.5: AUTOMATIC PRUNING
# ==========================================
print("\n--- STEP 2.5: AUTOMATED PRUNING RESULTS ---")

# Extract the p-values from the baseline model
p_values = baseline_model.pvalues

# Find variables that failed the test (p-value > threshold), excluding the constant
insignificant_vars = p_values[(p_values > p_val_threshold) & (p_values.index != 'const')].index.tolist()

if insignificant_vars:
    print(f"Dropping the following insignificant variables (p > {p_val_threshold}):")
    for var in insignificant_vars:
        print(f" ❌ {var} (p-val: {p_values[var]:.4f})")
else:
    print(f"✅ All variables passed the significance threshold (p < {p_val_threshold}). Nothing dropped.")

# Drop the dead weight from our X matrix
X_final = X_raw.drop(columns=insignificant_vars)

print("\n=== FINAL VARIABLES READY FOR MARKOV SWITCHING ===")
print("Target (Y):", Y.name)
print("Features (X):", X_final.columns.tolist())




import matplotlib.pyplot as plt

# ==========================================
# STEP 3: MARKOV SWITCHING MODEL SETUP
# ==========================================
print("\n--- STEP 3: ESTIMATING THE MS-ARX MODEL ---")

# Note: If switching_trend=True, statsmodels automatically handles the constant.
# We must drop the 'const' column from X_final to avoid a "matrix rank" mathematical error.
if 'const' in X_final.columns:
    X_ms = X_final.drop(columns=['const'])
else:
    X_ms = X_final

# Build the model
# k_regimes=2: Testing for two distinct market states
# switching_variance=True: Critical for IV; allows the error band to widen in a crisis
# switching_trend=True: Allows the baseline mean to shift
# switching_exog=False: Keeps macro variable impacts fixed initially for mathematical stability
ms_model = sm.tsa.MarkovRegression(
    endog=Y,
    k_regimes=2,
    exog=X_ms,
    switching_trend=True,
    switching_variance=True,
    switching_exog=False 
)

# Fit the model
# search_reps=20 forces the model to try 20 different random starting points.
# This heavily prevents the dreaded "Hessian Inversion" convergence failure.
print("Fitting the Markov Switching model. This requires Maximum Likelihood Estimation and may take a moment...")
ms_results = ms_model.fit(search_reps=20)

print("\n=== MARKOV SWITCHING MODEL SUMMARY ===")
print(ms_results.summary())

# ==========================================
# STEP 4: VISUALIZING THE REGIMES
# ==========================================
print("\n--- STEP 4: PLOTTING SMOOTHED REGIME PROBABILITIES ---")



# Create a two-panel plot
fig, axes = plt.subplots(2, 1, figsize=(14, 8), sharex=True)

# Top Panel: Plot the actual stationary target variable
axes[0].plot(Y.index, Y, color='black', linewidth=1.5, label='Actual Volatility Changes (Y)')
axes[0].axhline(0, color='grey', linestyle='--', alpha=0.5)
axes[0].set_title('Stationary Target Variable (First Difference of Log IV)', fontsize=12)
axes[0].legend(loc='upper left')
axes[0].grid(True, alpha=0.2)

# Bottom Panel: Plot the smoothed probability of being in Regime 1
# Note: Regime 1 is typically the "high variance" regime, but verify this in your summary output
prob_regime_1 = ms_results.smoothed_marginal_probabilities[1]

axes[1].plot(prob_regime_1.index, prob_regime_1, color='red', linewidth=1.5, label='Probability of Regime 1')
axes[1].fill_between(prob_regime_1.index, 0, prob_regime_1, color='red', alpha=0.3)
axes[1].axhline(0.5, color='black', linestyle=':', label='50% Threshold')
axes[1].set_title('Smoothed Probability of Being in Regime 1', fontsize=12)
axes[1].set_ylabel('Probability')
axes[1].legend(loc='upper left')
axes[1].grid(True, alpha=0.2)

plt.tight_layout()
plt.show()




