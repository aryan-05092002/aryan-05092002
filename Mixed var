    quarterly_indicators[ind] = monthly_to_quarterly(monthly_indicators[ind])

# Combine with quarterly GDP (aligning index)
full_quarterly_data = pd.concat([qpc_data1['REAL_GDP_QPC'], quarterly_indicators], axis=1)

# Parameters for rolling window
initial_train_end = pd.Period('2020Q4', freq='Q')
evaluation_end = pd.Period('2025Q2', freq='Q')
current_train_end = initial_train_end

forecasted = []
actuals = []
quarters = []

lag_order = 3  # as in the paper (lag length in months; here, quarterly data so adjust accordingly)

while current_train_end < evaluation_end:
    train_data = full_quarterly_data.loc[:current_train_end].dropna()

    # Estimate VAR with chosen variables and lags (adjust variable names as in paper)
    if len(train_data) <= lag_order:
        current_train_end += 1
        continue

    model = VAR(train_data)
    fitted_model = model.fit(maxlags=lag_order)

    # Forecast next period (1 step ahead)
    forecast_input = train_data.values[-lag_order:]
    next_quarter = current_train_end + 1

    # Only forecast if next_quarter exists and the actual value is available
    if next_quarter not in full_quarterly_data.index:
        break
    if np.isnan(full_quarterly_data.loc[next_quarter, 'REAL_GDP_QPC']):
        current_train_end += 1
        continue

    forecast = fitted_model.forecast(y=forecast_input, steps=1)[0][0]  # GDP is assumed as first column
    forecasted.append(forecast)
    actuals.append(full_quarterly_data.loc[next_quarter, 'REAL_GDP_QPC'])
    quarters.append(next_quarter)
    current_train_end += 1

# Make DataFrame of results
results_df = pd.DataFrame({'Quarter': quarters, 'Forecast': forecasted, 'Actual': actuals}).set_index('Quarter')
