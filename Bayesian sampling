while current_train_end < evaluation_end:
    # Select training data up to current train end
    train_data = qpc_data1.loc[qpc_data1.index <= current_train_end].dropna(subset=['REAL_GDP_QPC_YOY'] + indicators)

    # Standardize indicators for PCA
    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(train_data[indicators])

    # Extract factors with PCA
    pca = PCA(n_components=n_factors)
    factors_train = pca.fit_transform(X_train_scaled)

    factors_df = pd.DataFrame(factors_train, index=train_data.index, columns=[f'Factor_{i+1}' for i in range(n_factors)])

    # Combine factors with GDP YoY
    combined_df = pd.concat([train_data['REAL_GDP_QPC_YOY'], factors_df], axis=1).dropna()

    # Regression of GDP on factors
    X = sm.add_constant(combined_df[[f'Factor_{i+1}' for i in range(n_factors)]])
    y = combined_df['REAL_GDP_QPC_YOY']
    model = sm.OLS(y, X).fit()

    # Forecast next period
    next_period = current_train_end + 1
    
    if next_period <= pd.Period('2025Q2', freq='Q'):  # In-sample forecasts
        if next_period not in qpc_data1.index:
            current_train_end += 1
            continue

        # Prepare factors for next period by transforming standardized indicators
        next_indicators = qpc_data1.loc[next_period, indicators]
        
        # Skip if missing indicators
        if next_indicators.isnull().any():
            current_train_end += 1
            continue

        next_ind_scaled = scaler.transform(next_indicators.values.reshape(1, -1))
        next_factors = pca.transform(next_ind_scaled)
        X_next = sm.add_constant(pd.DataFrame(next_factors, columns=[f'Factor_{i+1}' for i in range(n_factors)]))
