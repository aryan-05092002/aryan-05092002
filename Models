import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.tsa.api import VAR
from sklearn.linear_model import Ridge

# Data variables list - replace with your actual columns
variables = ['REAL_GDP_QPC_YOY', 'var1', 'var2', 'var3']  # Ensure GDP is first

series = qpc_data1['REAL_GDP_QPC_YOY']
max_lag_ar = 10
max_lag_var = 4  # can optimize similar to previous code

forecasted = []
actuals = []
quarters = []

initial_train_end = pd.Period('2020Q4', freq='Q')
evaluation_end = pd.Period('2025Q2', freq='Q')
current_train_end = initial_train_end

while current_train_end < evaluation_end:
    train_data = qpc_data1.loc[:current_train_end, variables].dropna()

    if len(train_data) <= max_lag_ar:
        current_train_end += 1
        continue

    # AR(10) model
    ar_train = train_data[['REAL_GDP_QPC_YOY']].copy()
    for lag in range(1, max_lag_ar + 1):
        ar_train[f'lag_{lag}'] = ar_train['REAL_GDP_QPC_YOY'].shift(lag)
    ar_train.dropna(inplace=True)
    X_ar = ar_train[[f'lag_{lag}' for lag in range(1, max_lag_ar + 1)]]
    y_ar = ar_train['REAL_GDP_QPC_YOY']
    X_ar_const = sm.add_constant(X_ar)
    ar_model = sm.OLS(y_ar, X_ar_const).fit()

    test_period = current_train_end + 1
    if test_period not in qpc_data1.index:
        break

    # Test features for AR
    missing_ar = False
    test_features_ar = {}
    for lag in range(1, max_lag_ar + 1):
        lag_period = test_period - lag
        if lag_period in qpc_data1.index and not pd.isna(qpc_data1.loc[lag_period, 'REAL_GDP_QPC_YOY']):
            test_features_ar[f'lag_{lag}'] = qpc_data1.loc[lag_period, 'REAL_GDP_QPC_YOY']
        else:
            missing_ar = True
            break
    if missing_ar:
        current_train_end += 1
        continue
    X_test_ar = pd.DataFrame([test_features_ar])
    X_test_ar = sm.add_constant(X_test_ar)
    forecast_ar = ar_model.predict(X_test_ar)[0]

    # VAR model
    try:
        var_model = VAR(train_data)
        var_results = var_model.fit(maxlags=max_lag_var)
    except:
        current_train_end += 1
        continue

    last_vals = train_data.values[-var_results.k_ar:]
    forecast_var = var_results.forecast(y=last_vals, steps=1)[0][0]

    # Ridge regression on other vars
    ridge_train = train_data.dropna()
    X_ridge = ridge_train[variables[1:]]  # predictors excluding GDP
    y_ridge = ridge_train['REAL_GDP_QPC_YOY']
    ridge_model = Ridge()
    ridge_model.fit(X_ridge, y_ridge)

    if test_period not in qpc_data1.index or qpc_data1.loc[test_period, variables[1:]].isna().any():
        current_train_end += 1
        continue

    X_test_ridge = qpc_data1.loc[test_period, variables[1:]].values.reshape(1, -1)
    forecast_ridge = ridge_model.predict(X_test_ridge)[0]

    # Combine forecasts by equal weights
    combined_forecast = np.mean([forecast_ar, forecast_var, forecast_ridge])

    actual = qpc_data1.loc[test_period, 'REAL_GDP_QPC_YOY']

    forecasted.append(combined_forecast)
    actuals.append(actual)
    quarters.append(test_period)

    current_train_end += 1

# Compile results into DataFrame for analysis
results_df = pd.DataFrame({
    'Quarter': quarters,
    'Combined_Forecast': forecasted,
    'Actual': actuals
}).set_index('Quarter')

print(results_df)





